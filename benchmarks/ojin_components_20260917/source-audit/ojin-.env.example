# Copy to .env and fill in.
#
# NOTE: the headless demo (`docker compose --profile demo up`) needs NONE of this — it talks
# only to your local container. This file exists for the live-mic example, which uses cloud
# speech services, and for optionally overriding container defaults.

# ---------------------------------------------------------------------------
# Live-mic example (examples/live-mic) — cloud speech stack.
# These are the providers we run in production; all three are ordinary pipecat
# services and can be swapped for your own (see examples/live-mic/bot.py).
# ---------------------------------------------------------------------------
DEEPGRAM_KEY=            # speech-to-text   https://console.deepgram.com
GROQ_API_KEY=            # LLM              https://console.groq.com
ELEVENLABS_API_KEY=      # text-to-speech   https://elevenlabs.io

# Optional overrides for the live-mic example.
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # premade voice (Rachel)
# GROQ_MODEL=llama-3.3-70b-versatile
# SYSTEM_PROMPT=You are a friendly avatar assistant. Keep replies short.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Which face to drive: a filename in ./avatars (mounted read-only into the container).
OJIN_CONFIG_ID=sample.png
# Where the container is. Compose sets this for the demo service automatically;
# override only if you run the container elsewhere or on another port.
# OJIN_WS_URL=ws://localhost:8000/realtime
